    "morning_open": {
      "url": "audio/narration/morning_open.mp3",
      "durationMs": 6063,
      "text": "בוקר טוב. ארבע דקות, עם הקרם שֶׁלָּךְ, ואפשר אפילו בלי להסתכל על המסך.",
