  "narration": {
    "rel_posture_intro": {
      "url": "audio/narration/rel_posture_intro.mp3",
      "durationMs": 15180,
      "text": "נתחיל מהיציבה. שבי זקוף, הכתפיים רחוקות מהאוזניים. דמייני חוט שמושך את קודקוד הראש למעלה. הַסַּנְטֵר נסוג קצת לאחור, בלי להוריד אותו. נושמים חמש נשימות איטיות.",
      "qa": "approved"
    },
    "rel_posture_cue": {
      "url": "audio/narration/rel_posture_cue.mp3",
      "durationMs": 3190,
      "text": "הָעֹרֶף ארוך, הכתפיים רכות.",
      "qa": "pending"
    },
    "rel_neck_side_intro": {
      "url": "audio/narration/rel_neck_side_intro.mp3",
      "durationMs": 13273,
      "text": "עכשיו הטיה רכה. האוזן הימנית יורדת לכיוון הכתף הימנית. היד השמאלית נמשכת למטה, כאילו היא מחזיקה סל. בלי למשוך את הראש, רק לתת לו לשקוע.",
      "qa": "approved"
    },
    "rel_neck_side_cue": {
      "url": "audio/narration/rel_neck_side_cue.mp3",
      "durationMs": 3190,
      "text": "ועכשיו לצד השני, לאט.",
      "qa": "approved"
    },
    "rel_scm_intro": {
      "url": "audio/narration/rel_scm_intro.mp3",
      "durationMs": 12071,
      "text": "סובבי מעט את הראש שמאלה. עכשיו רואים את השריר שיורד מאחורי האוזן הימנית אל עצם הבריח. מלטפים אותו בשתי אצבעות, רק כלפי מטה, בלחץ קל.",
      "qa": "approved"
    },
    "rel_scm_cue": {
      "url": "audio/narration/rel_scm_cue.mp3",
      "durationMs": 3503,
      "text": "ועכשיו הצד השני. רק כלפי מטה.",
      "qa": "approved"
    },
    "rel_masseter_intro": {
      "url": "audio/narration/rel_masseter_intro.mp3",
      "durationMs": 17035,
      "text": "הניחי את שטוח האצבעות על הַלֶּסֶת, בדיוק מול האוזניים, מתחת לעצם הַלֶּחִי. פתחי את הפה מעט ותני לַלֶּסֶת ליפול. עכשיו מעגלים איטיים, בלחץ נעים. אם יש נקודה רגישה, תישארי עליה רגע ותנשמי.",
      "qa": "approved"
    },
    "rel_masseter_cue": {
      "url": "audio/narration/rel_masseter_cue.mp3",
      "durationMs": 3268,
      "text": "הַלֶּסֶת כבדה, השיניים לא נוגעות.",
      "qa": "approved"
    },
    "rel_temples_intro": {
      "url": "audio/narration/rel_temples_intro.mp3",
      "durationMs": 13273,
      "text": "קצות האצבעות על הָרַקּוֹת. מעגלים קטנים ואיטיים. עכשיו פתחי את האצבעות לתוך השיער, והזיזי את הקרקפת עצמה, מהמצח לכיוון הָעֹרֶף.",
      "qa": "approved"
    },
    "rel_temples_cue": {
      "url": "audio/narration/rel_temples_cue.mp3",
      "durationMs": 2380,
      "text": "נשימה ארוכה החוצה.",
      "qa": "approved"
    },
    "rel_forehead_intro": {
      "url": "audio/narration/rel_forehead_intro.mp3",
      "durationMs": 11575,
      "text": "הניחי את שתי כפות הידיים במרכז הַמֵּצַח. החליקי אותן לאט החוצה, עד הָרַקּוֹת. כל תנועה ארוכה ושקטה, כמו לגהץ בד רך.",
      "qa": "approved"
    },
    "rel_tongue_intro": {
      "url": "audio/narration/rel_tongue_intro.mp3",
      "durationMs": 14710,
      "text": "עכשיו הרגל קטן שכדאי לקחת לכל היום. הלשון כולה נחה שטוחה על הַחֵךְ, מאחורי השיניים העליונות. הַשְּׂפָתַיִם סגורות, השיניים לא נוגעות זו בזו. נושמים מהאף.",
      "qa": "approved"
    },
    "act_cheek_lift_intro": {
      "url": "audio/narration/act_cheek_lift_intro.mp3",
      "durationMs": 16617,
      "text": "התרגיל החשוב ביותר בתוכנית. הניחי את קצות האצבעות על עצמות הַלְּחָיַיִם. חַיְּכִי חיוך רחב, כך שהלחיים דוחפות את האצבעות למעלה. האצבעות נותנות קצת התנגדות. הַמֵּצַח נשאר רך לגמרי.",
      "qa": "approved"
    },
    "act_cheek_lift_cue": {
      "url": "audio/narration/act_cheek_lift_cue.mp3",
      "durationMs": 4235,
      "text": "הַלְּחָיַיִם עולות, העיניים והמצח רגועים.",
      "qa": "approved"
    },
    "act_cheek_o_intro": {
      "url": "audio/narration/act_cheek_o_intro.mp3",
      "durationMs": 11575,
      "text": "עשי צורת או עם הַשְּׂפָתַיִם, והצמידי אותן מעל השיניים. עכשיו, בלי לפתוח את האו, חַיְּכִי רק עם הַלְּחָיַיִם. מרגישים איך הן עולות.",
      "qa": "approved"
    },
    "act_cheek_o_cue": {
      "url": "audio/narration/act_cheek_o_cue.mp3",
      "durationMs": 1988,
      "text": "רק הַלְּחָיַיִם זזות.",
      "qa": "approved"
    },
    "act_cheek_puff_intro": {
      "url": "audio/narration/act_cheek_puff_intro.mp3",
      "durationMs": 13273,
      "text": "מלאי את הפה באוויר, הַשְּׂפָתַיִם סגורות. עכשיו העבירי את האוויר מלחי לַלֶּחִי, לאט, כמו גל קטן. אפשר גם מעל השפה העליונה ומתחת לתחתונה.",
      "qa": "approved"
    },
    "act_jaw_forward_intro": {
      "url": "audio/narration/act_jaw_forward_intro.mp3",
      "durationMs": 14710,
      "text": "הרימי מעט את הַסַּנְטֵר, והביטי קצת למעלה. עכשיו דחפי את הַלֶּסֶת התחתונה קדימה, עד שמרגישים מתיחה מתחת לַסַּנְטֵר ובצוואר. אם הַלֶּסֶת כואבת או נוקשת, עצרי ודלגי.",
      "qa": "approved"
    },
    "act_jaw_forward_cue": {
      "url": "audio/narration/act_jaw_forward_cue.mp3",
      "durationMs": 2458,
      "text": "מתיחה נעימה, לא כאב.",
      "qa": "approved"
    },
    "act_neck_kiss_intro": {
      "url": "audio/narration/act_neck_kiss_intro.mp3",
      "durationMs": 11261,
      "text": "הביטי לתקרה, בלי לזרוק את הראש אחורה. עכשיו מתחי את הַשְּׂפָתַיִם קדימה, כאילו את שולחת נשיקה לתקרה. מרגישים את קדמת הצוואר עובדת.",
      "qa": "approved"
    },
    "act_neck_kiss_cue": {
      "url": "audio/narration/act_neck_kiss_cue.mp3",
      "durationMs": 2537,
      "text": "הכתפיים רחוקות מהאוזניים.",
      "qa": "approved"
    },
    "act_tongue_press_intro": {
      "url": "audio/narration/act_tongue_press_intro.mp3",
      "durationMs": 12463,
      "text": "הצמידי את כל הלשון לַחֵךְ ולחצי למעלה. הניחי אצבע מתחת לַסַּנְטֵר, ותרגישי איך האזור מתהדק. הַשְּׂפָתַיִם סגורות, הַפָּנִים רגועות.",
      "qa": "approved"
    },
    "act_lips_intro": {
      "url": "audio/narration/act_lips_intro.mp3",
      "durationMs": 11575,
      "text": "גלגלי את שתי הַשְּׂפָתַיִם פנימה, מעל השיניים. הניחי אצבע מורה על כל קְצֵה של הפה, כדי שהעור לא יִתְקַמֵּט. עכשיו חיוך קטן, ומחזיקים.",
      "qa": "approved"
    },
    "act_lips_cue": {
      "url": "audio/narration/act_lips_cue.mp3",
      "durationMs": 2719,
      "text": "האצבעות שומרות על העור חלק.",
      "qa": "approved"
    },
    "act_eye_ring_intro": {
      "url": "audio/narration/act_eye_ring_intro.mp3",
      "durationMs": 15676,
      "text": "עשי וי עם האצבע המורה והאמצעית, והניחי אותן סביב העין, אחת בקצה הַגַּבָּה ואחת בצד העין. האצבעות מְיַצְּבוֹת את העור. הביטי למעלה, וכווצי קלות רק את הָעַפְעַף התחתון.",
      "qa": "approved"
    },
    "act_eye_ring_cue": {
      "url": "audio/narration/act_eye_ring_cue.mp3",
      "durationMs": 3581,
      "text": "האצבעות מְיַצְּבוֹת, הַמֵּצַח לא זז.",
      "qa": "pending"
    },
    "act_brow_intro": {
      "url": "audio/narration/act_brow_intro.mp3",
      "durationMs": 12855,
      "text": "הניחי כף יד שטוחה על כל הַמֵּצַח, ולחצי קלות. עכשיו נסי להרים את הַגַּבּוֹת. היד לא נותנת לעור להתקמט. השריר עובד, העור נשאר חלק.",
      "qa": "approved"
    },
    "lift_sweep_intro": {
      "url": "audio/narration/lift_sweep_intro.mp3",
      "durationMs": 15598,
      "text": "קצת שמן או קרם על כפות הידיים. עכשיו תנועות ארוכות כלפי מעלה: מֵהַסַּנְטֵר אל האוזניים, מצדי האף אל הָרַקּוֹת, וּמֵהַגַּבּוֹת אל הקרקפת. לאט, ובלחץ עדין.",
      "qa": "approved"
    },
    "lift_jawline_intro": {
      "url": "audio/narration/lift_jawline_intro.mp3",
      "durationMs": 13430,
      "text": "עשי וי עם האצבע המורה והאמצעית, וסגרי אותו על הַלֶּסֶת, אחת מעל העצם ואחת מתחת. החליקי מֵהַסַּנְטֵר אל האוזן, לאט, בשני הצדדים יחד.",
      "qa": "approved"
    },
    "lift_close_intro": {
      "url": "audio/narration/lift_close_intro.mp3",
      "durationMs": 10870,
      "text": "הניחי את שתי כפות הידיים על הַפָּנִים, ותרגישי את החום. שלוש נשימות עמוקות. שאיפה מהאף, ונשיפה ארוכה מהפה.",
      "qa": "approved"
    },
    "am_drain_intro": {
      "url": "audio/narration/am_drain_intro.mp3",
      "durationMs": 15337,
      "text": "בוקר טוב. ניקוז קצר, עם הקרם שֶׁלָּךְ. מתחילים מלמטה: לחיצות קלות מעל עצם הבריח. אחר כך מהאוזניים אל הצוואר, ומהלחיים אל האוזניים. הלחץ קל כמו נוצה.",
      "qa": "approved"
    },
    "am_eyes_intro": {
      "url": "audio/narration/am_eyes_intro.mp3",
      "durationMs": 8937,
      "text": "הַקְּמִיצָה היא האצבע העדינה ביותר. הקישי בָּהּ קלות מתחת לעין, מהאף החוצה, כמו טיפות גשם קטנות.",
      "qa": "approved"
    },
    "gs_jaw_intro": {
      "url": "audio/narration/gs_jaw_intro.mp3",
      "durationMs": 24140,
      "text": "שמן על הַפָּנִים והצוואר. החזיקי את האבן כמעט שטוחה על העור. מתחילים בצוואר, מלמטה למעלה. אחר כך קו הַלֶּסֶת, מֵהַסַּנְטֵר אל האוזן, ואז הַלְּחָיַיִם, מהאף אל האוזן. חמש העברות לכל קו, בלחץ קל. אדמומיות קלה זה בסדר. חבורה זה לא.",
      "qa": "approved"
